# Nilai contoh saja. Jangan isi rahasia di berkas ini.
# Variabel NEXT_PUBLIC_* masuk ke bundel klien dan bersifat publik.

# Publik
NEXT_PUBLIC_REFERRAL_ACCOUNT=ExampleReferralAccount1111111111111111111111111
NEXT_PUBLIC_REFERRAL_FEE_BPS=50

# Hanya di Cloudflare Pages Functions (variabel lingkungan Cloudflare, bukan repo)
RPC_UPSTREAM_URL=https://rpc.example.invalid/replace-with-provider-url
ALLOWED_ORIGINS=https://afterbell.example,http://localhost:3000
BLOCKED_COUNTRIES=US,CA
