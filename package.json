    "@wallet-standard/features": "^1.1.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "^2.57.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
